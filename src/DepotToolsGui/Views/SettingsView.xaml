<UserControl
    x:Class="DepotToolsGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:DepotToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DepotToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section card: one bordered container that groups a section's rows. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Section header (small grey uppercase label above each card). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9ca3af" />
        </Style>
        <!-- Thin divider between rows inside a card. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" Margin="8,16,8,24">
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{x:Static res:Strings.Settings_Title}" />

            <!-- DepotBox API key -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_DepotBox}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <!-- API provider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Medium" Text="Use API Key" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6b7280" Text="Use the DepotTools API broker or your own DepotBox API key." TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding UseApiKey, Mode=TwoWay}" />
                    </Grid>
                    <!-- Active key: stats card -->
                    <StackPanel Visibility="{Binding ShowDepotBoxStats, Converter={StaticResource BoolToVis}}">
                        <!-- Active badge + Refresh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Command="{Binding RefreshDepotBoxStatsCommand}"
                                Content="{x:Static res:Strings.Settings_DepotBoxRefresh}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Grid.Column="1"
                                Command="{Binding ClearDepotBoxKeyCommand}"
                                Content="{x:Static res:Strings.Settings_DepotBoxClear}"
                                Icon="{ui:SymbolIcon Dismiss24}" />
                        </Grid>
                        <!-- Usage progress card -->
                        <Border Margin="0,0,0,10" Padding="12" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding ShowDepotBoxStats, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Real ProgressBar (Fluent-styled, same as PluginView/ModeView/FixesView).
                                     DepotBoxUsagePercent is 0.0–1.0, so Maximum="1"; ProgressBar clamps past it.
                                     Indeterminate (animated) until stats load, so the card is never blank. -->
                                <ProgressBar
                                    Height="6"
                                    IsIndeterminate="{Binding DepotBoxStatsPending}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{Binding DepotBoxUsagePercent, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0" FontSize="13"
                                           Text="{Binding DepotBoxStatsText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Key input: only while NO key is saved. Once configured, the Refresh/Clear buttons +
                         usage card above are the whole story; "Clear" is how you swap keys (it resets
                         DepotBoxIsKeyConfigured, bringing this block back). The onboarding copy below reads
                         wrong when a key already exists, hence the collapse. -->
                    <StackPanel Visibility="{Binding ShowDepotBoxKeyInput, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{x:Static res:Strings.Settings_DepotBoxKey}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="#6b7280"
                            Text="{x:Static res:Strings.Settings_DepotBoxKey_Hint}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                FontFamily="Consolas"
                                PlaceholderText="{x:Static res:Strings.Settings_DepotBoxKeyPlaceholder}"
                                Text="{Binding DepotBoxKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding ValidateAndSaveDepotBoxKeyCommand}"
                                Content="{x:Static res:Strings.Settings_DepotBoxValidate}"
                                IsEnabled="{Binding CanEditDepotBoxKey}" />
                        </Grid>
                        <!-- Error text (only ever set by the two ValidateAndSaveDepotBoxKeyAsync failure paths,
                             so it can never be orphaned by this collapse). -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{Binding DepotBoxKeyStatusColor}"
                            Text="{Binding DepotBoxKeyStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding DepotBoxKeyStatus, Converter={StaticResource NullToCollapsed}}" />
                        <!-- "Get a key" link -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="#6b7280">
                            <Run Text="{x:Static res:Strings.Settings_DepotBoxGetKey}" />
                            <Hyperlink Command="{Binding OpenDepotBoxCommand}" Foreground="#a78bfa">depotboxmanifest.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hydra Cloud -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_HydraCloud}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Medium" Text="{x:Static res:Strings.Settings_HydraCloud_Title}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6b7280"
                                       Text="{x:Static res:Strings.Settings_HydraCloud_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:Button Margin="8,0,0,0" Command="{Binding SignInHydraCommand}"
                                       Content="{x:Static res:Strings.Settings_HydraCloud_SignIn}"
                                       Visibility="{Binding HydraCloudSignedIn, Converter={StaticResource InverseBoolToVis}}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding SignOutHydraCommand}"
                                       Appearance="Danger"
                                       Content="{x:Static res:Strings.Settings_HydraCloud_SignOut}"
                                       Visibility="{Binding HydraCloudSignedIn, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                    <Border Margin="0,12,0,0" Style="{StaticResource RowDivider}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Medium" Text="{x:Static res:Strings.Settings_HydraCloud_Automatic}" />
                            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6b7280"
                                       Text="{x:Static res:Strings.Settings_HydraCloud_Automatic_Hint}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                         IsEnabled="{Binding HydraCloudHasSubscription}"
                                         IsChecked="{Binding CloudSavesEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Install behavior -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Install}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Auto Update Apps -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AutoUpdateApps, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General (language) -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_General}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Settings_Language}" />
                    <ComboBox
                        Margin="0,8,0,0"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="#6b7280"
                        Text="{x:Static res:Strings.Settings_Language_Hint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Steam -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Steam}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Settings_SteamLocation}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SteamPath, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding OverrideSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Command="{Binding ClearSteamOverrideCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSteamOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="#6b7280"
                        Text="{Binding SteamSource}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#f87171"
                        Text="{Binding SteamWarning}"
                        TextWrapping="Wrap"
                        Visibility="{Binding SteamWarning, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Startup}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Start with Windows -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_StartWithWindows_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- Minimize to System Tray -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
